<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@color/plum">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PANTRYBLOOM" android:textSize="13sp" android:letterSpacing="0.14" android:textColor="@color/pale_rose"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Fresh ideas from what's inside" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/white" android:drawableStart="@drawable/ic_leaf_white" android:drawablePadding="9dp"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/main_content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp" android:background="@color/white" android:orientation="horizontal">
        <Button android:id="@+id/nav_pantry" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Pantry" android:textAllCaps="false" android:backgroundTint="@color/pale_rose" android:textColor="@color/plum" android:drawableTop="@drawable/ic_pantry_primary" android:drawablePadding="3dp" android:minHeight="70dp" android:gravity="center" android:contentDescription="Pantry tab"/>
        <Button android:id="@+id/nav_recipes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cook" android:textAllCaps="false" android:backgroundTint="@color/pale_rose" android:textColor="@color/plum" android:drawableTop="@drawable/ic_chef_primary" android:drawablePadding="3dp" android:minHeight="70dp" android:gravity="center" android:contentDescription="Cook tab"/>
        <Button android:id="@+id/nav_settings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Settings" android:textAllCaps="false" android:backgroundTint="@color/pale_rose" android:textColor="@color/plum" android:drawableTop="@drawable/ic_settings_primary" android:drawablePadding="3dp" android:minHeight="70dp" android:gravity="center" android:contentDescription="Settings tab"/>
    </LinearLayout>
</LinearLayout>
