<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="16dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="My Pantry" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/ink"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="Keep the ingredients you already have in one place."
        android:textSize="14sp" android:textColor="@color/muted"/>
    <Button android:id="@+id/add_ingredient" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="+ Add ingredient" android:textAllCaps="false"
        android:textColor="@color/white" android:background="@drawable/bg_action"/>
    <TextView android:id="@+id/pantry_count" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:layout_marginBottom="10dp"
        android:text="MY INGREDIENTS" android:letterSpacing="0.1" android:textSize="12sp" android:textColor="@color/plum"/>
    <TextView android:id="@+id/pantry_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_card" android:padding="20dp"
        android:text="Nothing in your pantry yet. Add an ingredient to start." android:textColor="@color/muted"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pantry_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="12dp"/>
</LinearLayout>
