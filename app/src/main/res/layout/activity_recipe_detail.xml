<?xml version='1.0' encoding='UTF-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PANTRYBLOOM RECIPE" android:textColor="@color/coral" android:letterSpacing="0.1"/>
        <TextView android:id="@+id/detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Recipe" android:textColor="@color/plum" android:textSize="27sp" android:textStyle="bold" android:drawableStart="@drawable/ic_chef_primary" android:drawablePadding="9dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Ingredients" android:textSize="20sp" android:textColor="@color/ink" android:textStyle="bold" android:drawableStart="@drawable/ic_leaf_primary" android:drawablePadding="9dp"/>
        <TextView android:id="@+id/detail_ingredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="18dp" android:background="@drawable/bg_card" android:textColor="@color/ink" android:textSize="16sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="Method" android:textSize="20sp" android:textColor="@color/ink" android:textStyle="bold" android:drawableStart="@drawable/ic_recipes_primary" android:drawablePadding="9dp"/>
        <TextView android:id="@+id/detail_method" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="18dp" android:background="@drawable/bg_card" android:textColor="@color/ink" android:textSize="16sp"/>
        <Button android:id="@+id/detail_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Back to recipes" android:textAllCaps="false" android:textColor="@color/white" android:background="@drawable/bg_action" android:drawableStart="@drawable/ic_back_white" android:drawablePadding="9dp" android:minHeight="52dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:backgroundTint="@null"/>
    </LinearLayout>
</ScrollView>
