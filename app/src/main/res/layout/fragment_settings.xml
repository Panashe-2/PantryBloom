<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your Preferences" android:textSize="27sp" android:textStyle="bold" android:textColor="@color/ink" android:drawableStart="@drawable/ic_settings_primary" android:drawablePadding="9dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Make your pantry feel like yours." android:textSize="14sp" android:textColor="@color/muted"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/bg_card">
        <Switch android:id="@+id/expiry_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Highlight soon-to-expire items" android:textColor="@color/ink" android:textSize="16sp" android:checked="true" android:drawableStart="@drawable/ic_calendar_primary" android:drawablePadding="9dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="An ingredient is highlighted when its expiry date is within three days." android:textColor="@color/muted"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:background="@drawable/bg_soft" android:padding="18dp" android:textColor="@color/plum" android:text="No account or internet needed. Your pantry and 20 seed recipes are stored on this device using Room (SQLite)." android:drawableStart="@drawable/ic_info_primary" android:drawablePadding="9dp"/>
</LinearLayout>
