<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:padding="18dp">
    <TextView android:id="@+id/recipe_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" android:drawableStart="@drawable/ic_chef_primary" android:drawablePadding="9dp"/>
    <TextView android:id="@+id/recipe_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="All ingredients available" android:textColor="@color/plum" android:textSize="13sp" android:drawableStart="@drawable/ic_check_primary" android:drawablePadding="9dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="View recipe  ›" android:textSize="13sp" android:textColor="@color/coral" android:drawableEnd="@drawable/ic_arrow_accent" android:drawablePadding="9dp"/>
</LinearLayout>
